.{
    .id = "com.emadgh.windows3dviewer",
    .name = "windows-3d-viewer",
    .display_name = "Windows 3D Viewer",
    .description = "A fast local 3D model viewer for common interchange formats.",
    .version = "0.2.2",
    .platforms = .{ "windows" },
    .permissions = .{},
    .capabilities = .{ "webview", "js_bridge" },
    .bridge = .{
        .commands = .{
            .{ .name = "app.registerFileAssociations", .origins = .{ "zero://app", "http://127.0.0.1:5173" } },
            .{ .name = "app.openDefaultApps", .origins = .{ "zero://app", "http://127.0.0.1:5173" } },
            .{ .name = "app.getLaunchManifest", .origins = .{ "zero://app", "http://127.0.0.1:5173" } },
            .{ .name = "app.readLaunchFileChunk", .origins = .{ "zero://app", "http://127.0.0.1:5173" } },
            .{ .name = "app.consumeLaunchRequest", .origins = .{ "zero://app", "http://127.0.0.1:5173" } },
        },
    },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "npm", "--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline", "http://127.0.0.1:5173" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .windows = .{
        .{
            .label = "main",
            .title = "Windows 3D Viewer",
            .width = 1400,
            .height = 900,
            .restore_state = true,
        },
    },
}
